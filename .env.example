# Скопировать в .env (не в бэкапы с секретами)

# Mouser Search API — https://www.mouser.com/api-hub/
MOUSER_API_KEY=

# Если Mouser/Digi-Key отдают 403 Access Denied (часто из BY) — VPN или прокси:
# HTTPS_PROXY=http://user:pass@host:port

# Digi-Key (этап M3) — https://developer.digikey.com/
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
